     7                                  %macro Descriptor 3
     8                                      dw %2 & 0xFFFF      ; 段界限 15:0
     9                                      dw %1 & 0xFFFF      ; 段基址 15:0
    10                                      db (%1 >> 16) & 0xFF ; 段基址 23:16
    11                                      dw ((%2 >> 8) & 0xF00) | (%3 & 0F0FFh) ; 段界限 19:16 + 段属性
    12                                      db (%1 >> 24) & 0xFF ;
    13                                  %endmacro
